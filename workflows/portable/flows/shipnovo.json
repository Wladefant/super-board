{
  "schema": "flow-qa/v1",
  "project": "shipnovo",
  "version": "1.0.0",
  "description": "Content-bound real user Flow QA definitions for Shipnovo covering native article lifecycle (create, edit, save, tabs, keyboard focus, mobile touch swipe dismissal, desktop close, and delete with failure-safe cleanup), phone row edit reachability, offer sheet swipe dismissal, return tabs single row, DHL PDF upload no-dead-end, order edit internal notes, and packing mode scan with stop before ship confirmation.",
  "viewports": [
    "390x844",
    "390x420",
    "1440x900"
  ],
  "themes": [
    "light",
    "dark"
  ],
  "flows": [
    {
      "id": "messages_keyboard",
      "name": "Messages list, composer keyboard, and return without sending",
      "read_only": true,
      "fixture_states": ["populated"],
      "steps": [
        {"id":"messages_list","action":"goto","url":"/messages","checks":["no_horizontal_overflow"]},
        {"id":"conversation_ready","action":"assert","selector":"[aria-label='Konversationsliste'] button:not(:has([aria-label='Ungelesen']))","expected_present":true,"readiness_missing":"a read reply-capable conversation in the signed-in account"},
        {"id":"open_conversation","action":"tap","selector":"[aria-label='Konversationsliste'] button:not(:has([aria-label='Ungelesen']))","checks":["visible","element_from_point","tap_target_min_44","no_document_reload"]},
        {"id":"composer_ready","action":"assert","selector":"textarea[aria-label='Antwort an den eBay-Käufer']:not(:disabled)","expected_present":true,"readiness_missing":"an enabled reply composer"},
        {"id":"no_open_error","action":"assert","selector":"[data-sonner-toast][data-type='error'], [role='alert'].text-destructive, [role='alert']:has-text('Fehler')","expected_present":false},
        {"id":"tap_composer_focus","action":"tap","selector":"textarea[aria-label='Antwort an den eBay-Käufer']","checks":["visible","element_from_point","tap_target_min_44"]},
        {"id":"composer_keyboard","action":"keyboard-open","selector":"textarea[aria-label='Antwort an den eBay-Käufer']","checks":["visible","element_from_point","input_focus_in_viewport","tap_target_min_44"]},
        {"id":"composer_visible_with_keyboard","action":"assert","keyboard_open":true,"selector":"textarea[aria-label='Antwort an den eBay-Käufer']","expected_present":true,"checks":["visible","element_from_point","in_viewport","input_focus_in_viewport","tap_target_min_44"]},
        {"id":"send_visible_with_keyboard_not_tapped","action":"assert","keyboard_open":true,"scroll":true,"selector":"button:has-text('Senden')","expected_present":true,"checks":["visible","element_from_point","in_viewport","input_focus_in_viewport","tap_target_min_44"]},
        {"id":"back_to_list","action":"tap","touch_only":true,"selector":"button:has-text('Zurück zur Liste')","checks":["visible","element_from_point","tap_target_min_44","no_document_reload"]},
        {"id":"list_restored","action":"assert","touch_only":true,"selector":"[aria-label='Konversationsliste']","expected_present":true,"expected_visible":true,"checks":["visible","no_document_reload"]},
        {"id":"no_return_error","action":"assert","selector":"[data-sonner-toast][data-type='error'], [role='alert'].text-destructive, [role='alert']:has-text('Fehler')","expected_present":false}
      ],
      "cleanup": []
    },
    {
      "id": "account_orders_ready",
      "name": "Discover the first signed-in order without saving",
      "read_only": true,
      "fixture_states": ["populated"],
      "steps": [
        {"id":"orders_list","action":"goto","url":"/orders","checks":["no_horizontal_overflow"]},
        {"id":"order_ready","action":"assert","selector":"main table tbody tr button:has-text('Kurzansicht'), main div.rounded-lg.border button.truncate","expected_present":true,"readiness_missing":"an order in the signed-in account","checks":["visible"]}
      ],
      "cleanup": []
    },
    {
      "id": "account_empty_ready",
      "name": "Empty fixture readiness",
      "read_only": true,
      "fixture_states": ["empty"],
      "steps": [
        {"id":"empty_messages","action":"goto","url":"/messages","checks":["no_horizontal_overflow"]},
        {"id":"empty_state_ready","action":"assert","selector":"[aria-label='Konversationsliste']","expected_present":true,"expected_text":"Keine passenden Nachrichten","readiness_missing":"the empty messages state"},
        {"id":"empty_has_no_conversation","action":"assert","selector":"[aria-label='Konversationsliste'] button","expected_present":false},
        {"id":"empty_orders","action":"goto","url":"/orders","checks":["no_horizontal_overflow"]},
        {"id":"empty_orders_ready","action":"assert","selector":"main","expected_present":true,"expected_text":"Noch keine Bestellungen","readiness_missing":"the empty orders state"},
        {"id":"empty_has_no_order","action":"assert","selector":"main table tbody tr button:has-text('Kurzansicht'), main div.rounded-lg.border button.truncate","expected_present":false}
      ],
      "cleanup": []
    },
    {
      "id": "account_disconnected_ready",
      "name": "Disconnected fixture readiness",
      "read_only": true,
      "fixture_states": ["disconnected"],
      "steps": [
        {"id":"disconnected_settings","action":"goto","url":"/settings/ebay","checks":["no_horizontal_overflow"]},
        {"id":"disconnected_state_ready","action":"assert","selector":"main","expected_present":true,"expected_text":"Nicht verbunden","readiness_missing":"a disconnected eBay account"},
        {"id":"disconnected_no_connection","action":"assert","selector":"main","expected_present":true,"expected_text":"Noch nicht verbunden"}
      ],
      "cleanup": []
    },
    {
      "id": "account_limited_ready",
      "name": "Limited member reads messages but cannot manage accounts",
      "read_only": true,
      "fixture_states": ["limited"],
      "steps": [
        {"id":"limited_messages","action":"goto","url":"/messages","checks":["no_horizontal_overflow"]},
        {"id":"limited_thread_ready","action":"assert","selector":"[aria-label='Konversationsliste'] button:not(:has([aria-label='Ungelesen']))","expected_present":true,"readiness_missing":"a read conversation for the limited member"},
        {"id":"limited_open_thread","action":"tap","selector":"[aria-label='Konversationsliste'] button:not(:has([aria-label='Ungelesen']))","checks":["visible","element_from_point","tap_target_min_44"]},
        {"id":"limited_message_content","action":"assert","selector":"main article","expected_present":true,"readiness_missing":"visible conversation messages","scroll":true,"checks":["visible"]},
        {"id":"limited_message_visible","action":"assert","selector":"main","expected_present":true,"expected_text":"Du kannst diese Unterhaltung lesen."},
        {"id":"limited_no_composer","action":"assert","selector":"textarea[aria-label='Antwort an den eBay-Käufer']","expected_present":false},
        {"id":"limited_no_send","action":"assert","selector":"button:has-text('Senden')","expected_present":false},
        {"id":"limited_no_open_error","action":"assert","selector":"[data-sonner-toast][data-type='error'], [role='alert'].text-destructive, [role='alert']:has-text('Fehler')","expected_present":false},
        {"id":"limited_account_access_denied","action":"goto","url":"/settings/ebay","expected_url":"^/access-denied"},
        {"id":"limited_denial_visible","action":"assert","selector":"main","expected_present":true,"expected_text":"Keine Berechtigung"}
      ],
      "cleanup": []
    },
    {
      "id": "article_lifecycle_native",
      "name": "Nativer Artikel-Lebenszyklus mit Tastatur, Tabs, Bearbeitung und Loeschung",
      "description": "Erfasst einen eindeutigen internen Artikel (QA-ART-489-NAT), prueft Tastaturfokus und Viewport bei geoeffneter Tastatur (390x420), bedient Tabs, speichert den Artikel, prueft die gespeicherte Zeile, oeffnet die Zeilenbearbeitung ('<sku> bearbeiten'), schliesst das Sheet per nativem CDP-Touch-Swipe auf Mobile (390x844 und 390x420) sowie per Desktop-Schliessen-Control auf 1440x900, loescht den Artikel ueber das Aktionsmenue ('Weitere Aktionen fuer <sku>' -> 'Artikel loeschen' -> Bestaetigung) und fuehrt ein fehlschlagsicheres Cleanup nur des eigenen Artikels aus.",
      "allowed_actions": [
        "goto",
        "tap",
        "type",
        "keyboard-open",
        "swipe",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "delete_database",
        "ebay_publish",
        "purchase_label",
        "confirm_ship"
      ],
      "steps": [
        {
          "id": "goto_products_page",
          "action": "goto",
          "url": "/products",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "open_review_tools_menu_if_present",
          "action": "tap",
          "selector": "button[aria-label='More review tools']",
          "optional": true,
          "timeout_ms": 3000
        },
        {
          "id": "stow_review_toolbar_if_present",
          "action": "tap",
          "selector": "button[aria-label='Hide toolbar']",
          "optional": true,
          "timeout_ms": 3000
        },
        {
          "id": "open_article_dialog",
          "action": "tap",
          "selector": "button[aria-label='Artikel anlegen'], button:has-text('Artikel anlegen'), [data-testid='btn-create-article']",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_dialog_open",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": true,
          "timeout_ms": 5000
        },
        {
          "id": "open_keyboard_sku_focus",
          "action": "keyboard-open",
          "selector": "input[name='sku']",
          "checks": [
            "visible",
            "input_focus_in_viewport",
            "element_from_point"
          ]
        },
        {
          "id": "type_sku",
          "action": "type",
          "selector": "input[name='sku']",
          "text": "QA-ART-489-NAT",
          "mutation": true,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "type_title",
          "action": "type",
          "selector": "input[name='title']",
          "text": "QA-Flow 489 Native Artikel",
          "mutation": true,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "type_variant",
          "action": "type",
          "selector": "input[name='variant']",
          "text": "QA-Var-Schwarz-L",
          "mutation": true,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "tap_shipping_tab",
          "action": "tap",
          "selector": "[role='dialog'] button:has-text('Versandvorgaben')",
          "checks": [
            "visible",
            "element_from_point"
          ]
        },
        {
          "id": "tap_storage_tab",
          "action": "tap",
          "selector": "[role='dialog'] button:has-text('Lagerplätze')",
          "checks": [
            "visible",
            "element_from_point"
          ]
        },
        {
          "id": "save_created_article",
          "action": "tap",
          "selector": "[role='dialog'] button[type='submit'], [role='dialog'] button:has-text('Artikel speichern')",
          "checks": [
            "visible",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_create_dialog_closed",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": false,
          "timeout_ms": 8000
        },
        {
          "id": "assert_article_saved_in_table",
          "action": "assert",
          "selector": "button[aria-label='QA-ART-489-NAT bearbeiten'], table tr:has-text('QA-ART-489-NAT')",
          "expected_present": true,
          "timeout_ms": 8000,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "tap_row_edit_button",
          "action": "tap",
          "selector": "button[aria-label='QA-ART-489-NAT bearbeiten']",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_edit_sheet_open",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": true,
          "timeout_ms": 5000
        },
        {
          "id": "type_updated_title",
          "action": "type",
          "selector": "[role='dialog'] input[name='title']",
          "text": "QA-Flow 489 Native Artikel Editiert",
          "mutation": true,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "save_edited_article",
          "action": "tap",
          "selector": "[role='dialog'] button[type='submit'], [role='dialog'] button:has-text('Artikel speichern')",
          "checks": [
            "visible",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_edit_dialog_closed_after_save",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": false,
          "timeout_ms": 8000
        },
        {
          "id": "assert_edited_title_in_table",
          "action": "assert",
          "selector": "table",
          "expected_text": "QA-Flow 489 Native Artikel Editiert",
          "checks": [
            "visible"
          ]
        },
        {
          "id": "tap_row_edit_again_for_sheet_dismissal",
          "action": "tap",
          "selector": "button[aria-label='QA-ART-489-NAT bearbeiten']",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_sheet_open_for_dismissal",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": true,
          "timeout_ms": 5000
        },
        {
          "id": "dismiss_mobile_sheet_via_cdp_touch_swipe",
          "action": "swipe",
          "selector": "[role='dialog'] div.touch-none, [role='dialog'] > div.touch-none",
          "touch_only": true,
          "direction": "down",
          "distance": 450,
          "assert_dismissal": true,
          "checks": [
            "dismissed"
          ]
        },
        {
          "id": "close_desktop_sheet_via_close_button",
          "action": "tap",
          "selector": "[role='dialog'] button:has-text('Abbrechen'), [role='dialog'] button[aria-label='Schließen'], [role='dialog'] button:has-text('Schließen')",
          "desktop_only": true,
          "checks": [
            "visible",
            "element_from_point"
          ]
        },
        {
          "id": "assert_sheet_dismissed",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": false,
          "timeout_ms": 6000
        },
        {
          "id": "open_row_more_actions_menu",
          "action": "tap",
          "selector": "button[aria-label='Weitere Aktionen für QA-ART-489-NAT']",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        },
        {
          "id": "tap_delete_menu_item",
          "action": "tap",
          "selector": "[role='menuitem']:has-text('Artikel löschen'), [role='menu'] div:has-text('Artikel löschen')",
          "checks": [
            "visible",
            "element_from_point"
          ]
        },
        {
          "id": "assert_delete_confirm_dialog_open",
          "action": "assert",
          "selector": "[role='alertdialog'], [role='dialog']",
          "expected_present": true,
          "timeout_ms": 5000
        },
        {
          "id": "confirm_article_deletion",
          "action": "tap",
          "selector": "[role='alertdialog'] button:has-text('Artikel löschen'), [role='dialog'] button:has-text('Artikel löschen')",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_delete_dialog_closed",
          "action": "assert",
          "selector": "[role='dialog']:has-text('Artikel löschen'), [role='alertdialog']",
          "expected_present": false,
          "timeout_ms": 8000
        },
        {
          "id": "assert_article_deleted_from_table",
          "action": "assert",
          "selector": "button[aria-label='QA-ART-489-NAT bearbeiten']",
          "expected_present": false,
          "timeout_ms": 5000
        }
      ],
      "cleanup": [
        {
          "id": "cleanup_close_dialog_if_open",
          "action": "cleanup",
          "selector": "[role='dialog'] button:has-text('Abbrechen'), [role='dialog'] button[aria-label='Schließen'], [role='alertdialog'] button:has-text('Abbrechen')"
        },
        {
          "id": "cleanup_open_more_actions_if_row_exists",
          "action": "cleanup",
          "selector": "button[aria-label='Weitere Aktionen für QA-ART-489-NAT']",
          "then": "[role='menuitem']:has-text('Artikel löschen')"
        },
        {
          "id": "cleanup_confirm_delete_if_dialog_open",
          "action": "cleanup",
          "selector": "[role='alertdialog'] button:has-text('Artikel löschen'), [role='dialog'] button:has-text('Artikel löschen')"
        }
      ]
    },
    {
      "id": "article_row_edit_phone",
      "name": "Artikel-Zeilenbearbeitung auf dem Smartphone erreichbar",
      "description": "Prueft, ob in der Artikeltabelle auf dem Smartphone (390x844) eine sichtbare, erreichbare Bearbeiten-Aktion mit Mindest-Touch-Target vorhanden ist, ohne horizontales Scrollen zu erzwingen.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "delete_database",
        "drop_table",
        "ebay_publish"
      ],
      "steps": [
        {
          "id": "goto_products_page",
          "action": "goto",
          "url": "/products",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "tap_row_edit_action",
          "action": "tap",
          "selector": "table tbody tr:first-child button[aria-label*='bearbeiten'], table tbody tr:first-child button:has-text('Bearbeiten'), table tbody tr:first-child a[aria-label*='bearbeiten']",
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "assert_edit_sheet_open",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": true
        }
      ],
      "cleanup": [
        {
          "id": "cleanup_close_edit_dialog",
          "action": "cleanup",
          "selector": "[role='dialog'] button:has-text('Abbrechen'), [role='dialog'] button[aria-label='Schließen']"
        }
      ]
    },
    {
      "id": "offer_sheet_swipe_close",
      "name": "Angebotsdetail-Sheet per Swipe nach unten schliessen",
      "description": "Oeffnet ein eBay-Angebot in der mobilen Sheet-Ansicht und prueft, ob das Sheet per Swipe-Geste nach unten geschlossen werden kann.",
      "allowed_actions": [
        "goto",
        "tap",
        "swipe",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "delete_database",
        "ebay_publish",
        "purchase_label"
      ],
      "steps": [
        {
          "id": "goto_listings_page",
          "action": "goto",
          "url": "/listings",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "open_offer_detail_sheet",
          "action": "tap",
          "selector": "main ul > li button, main table tbody tr td button:not([role='checkbox'])",
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point"
          ]
        },
        {
          "id": "assert_sheet_present",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": true,
          "timeout_ms": 5000
        },
        {
          "id": "swipe_down_to_dismiss_sheet",
          "action": "swipe",
          "selector": "[role='dialog'] > div.touch-none",
          "touch_only": true,
          "direction": "down",
          "distance": 400,
          "assert_dismissal": true,
          "checks": [
            "dismissed"
          ]
        },
        {
          "id": "assert_sheet_dismissed_state",
          "action": "assert",
          "selector": "[role='dialog']",
          "touch_only": true,
          "expected_present": false
        }
      ],
      "cleanup": [
        {
          "id": "cleanup_close_sheet_fallback",
          "action": "cleanup",
          "selector": "[role='dialog'] button[aria-label='Close'], [role='dialog'] button[aria-label='Schließen'], [role='dialog'] button:has-text('Schließen')"
        }
      ]
    },
    {
      "id": "returns_tabs_same_row",
      "name": "Retouren-Filtertabs in einer Zeile ohne Reload",
      "description": "Prueft, dass die Status-Tabs auf /returns mobil in einer einzigen horizontal scrollbaren Zeile liegen (kein Umbruch ueber mehrere Zeilen) und Filterwechsel ohne Dokument-Reload erfolgen.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "delete_database",
        "create_external_return"
      ],
      "steps": [
        {
          "id": "goto_returns_page",
          "action": "goto",
          "url": "/returns",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "verify_status_tabs_container",
          "action": "assert",
          "selector": "[aria-label='Retouren filtern'], [data-testid='status-tabs']",
          "expected_present": true
        },
        {
          "id": "tap_tab_offen",
          "action": "tap",
          "selector": "[aria-label='Retouren filtern'] button:nth-child(2), button:has-text('Offen')",
          "no_document_reload": true,
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point",
            "no_document_reload"
          ]
        },
        {
          "id": "tap_tab_wartet",
          "action": "tap",
          "selector": "[aria-label='Retouren filtern'] button:nth-child(3), button:has-text('Wartet')",
          "no_document_reload": true,
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point",
            "no_document_reload"
          ]
        },
        {
          "id": "assert_returns_table_present",
          "action": "assert",
          "selector": "[aria-label='Retouren filtern']",
          "expected_present": true
        }
      ],
      "cleanup": []
    },
    {
      "id": "dhl_pdf_upload_stock",
      "name": "DHL-Label-PDF-Upload ohne Vorrats-Sackgasse",
      "description": "Prueft den Upload von DHL-Label-PDFs auf /labels bzw. /templates und stellt sicher, dass fehlende Labelvorraete automatisch angelegt werden statt in einer Fehlermeldungs-Sackgasse zu enden. Laedt das DHL-Common-Label-Beispiel (nur Fake-Daten) als QA-flow-dhl-sample hoch; im echten Konto entstehen dadurch Labels, daher loescht das Cleanup jede Datei QA-flow-dhl-sample* wieder.",
      "allowed_actions": [
        "goto",
        "tap",
        "upload",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "delete_database",
        "purchase_label",
        "confirm_ship"
      ],
      "steps": [
        {
          "id": "goto_labels_page",
          "action": "goto",
          "url": "/labels",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "verify_upload_control_present",
          "action": "assert",
          "selector": "button:has-text('DHL-PDF hochladen'), input[type='file'][accept*='pdf']",
          "expected_present": true
        },
        {
          "id": "upload_sample_dhl_pdf",
          "action": "upload",
          "selector": "input[type='file'][accept*='pdf']",
          "file": "workflows/portable/fixtures/QA-flow-dhl-sample.pdf",
          "checks": [
            "visible"
          ]
        },
        {
          "id": "assert_upload_handled_without_dead_end",
          "action": "assert",
          "selector": "[role='alert'], [data-sonner-toast], [role='status'], .text-destructive, h2:has-text('Labels')",
          "expected_present": true
        },
        {
          "id": "wait_until_upload_reported",
          "action": "assert",
          "selector": "[data-sonner-toast]",
