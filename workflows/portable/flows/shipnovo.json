{
  "schema": "flow-qa/v1",
  "project": "shipnovo",
  "version": "1.0.0",
  "description": "Content-bound real user Flow QA definitions for Shipnovo covering native article lifecycle (create, edit, save, tabs, keyboard focus, mobile touch swipe dismissal, desktop close, and delete with failure-safe cleanup), phone row edit reachability, offer sheet swipe dismissal, return tabs single row, DHL PDF upload no-dead-end, order edit internal notes, and packing mode scan with stop before ship confirmation.",
  "viewports": [
    "390x844",
    "390x420",
    "1440x900"
  ],
  "themes": [
    "light",
    "dark"
  ],
  "flows": [
    {
      "id": "article_lifecycle_native",
      "name": "Nativer Artikel-Lebenszyklus mit Tastatur, Tabs, Bearbeitung und Loeschung",
      "description": "Erfasst einen eindeutigen internen Artikel (QA-ART-489-NAT), prueft Tastaturfokus und Viewport bei geoeffneter Tastatur (390x420), bedient Tabs, speichert den Artikel, prueft die gespeicherte Zeile, oeffnet die Zeilenbearbeitung ('<sku> bearbeiten'), schliesst das Sheet per nativem CDP-Touch-Swipe auf Mobile (390x844 und 390x420) sowie per Desktop-Schliessen-Control auf 1440x900, loescht den Artikel ueber das Aktionsmenue ('Weitere Aktionen fuer <sku>' -> 'Artikel loeschen' -> Bestaetigung) und fuehrt ein fehlschlagsicheres Cleanup nur des eigenen Artikels aus.",
      "allowed_actions": [
        "goto",
        "tap",
        "type",
        "keyboard-open",
        "swipe",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "delete_database",
        "ebay_publish",
        "purchase_label",
        "confirm_ship"
      ],
      "steps": [
        {
          "id": "goto_products_page",
          "action": "goto",
          "url": "/products",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "open_review_tools_menu_if_present",
          "action": "tap",
          "selector": "button[aria-label='More review tools']",
          "optional": true,
          "timeout_ms": 3000
        },
        {
          "id": "stow_review_toolbar_if_present",
          "action": "tap",
          "selector": "button[aria-label='Hide toolbar']",
          "optional": true,
          "timeout_ms": 3000
        },
        {
          "id": "open_article_dialog",
          "action": "tap",
          "selector": "button[aria-label='Artikel anlegen'], button:has-text('Artikel anlegen'), [data-testid='btn-create-article']",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_dialog_open",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": true,
          "timeout_ms": 5000
        },
        {
          "id": "open_keyboard_sku_focus",
          "action": "keyboard-open",
          "selector": "input[name='sku']",
          "checks": [
            "visible",
            "input_focus_in_viewport",
            "element_from_point"
          ]
        },
        {
          "id": "type_sku",
          "action": "type",
          "selector": "input[name='sku']",
          "text": "QA-ART-489-NAT",
          "mutation": true,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "type_title",
          "action": "type",
          "selector": "input[name='title']",
          "text": "QA-Flow 489 Native Artikel",
          "mutation": true,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "type_variant",
          "action": "type",
          "selector": "input[name='variant']",
          "text": "QA-Var-Schwarz-L",
          "mutation": true,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "tap_shipping_tab",
          "action": "tap",
          "selector": "[role='dialog'] button:has-text('Versandvorgaben')",
          "checks": [
            "visible",
            "element_from_point"
          ]
        },
        {
          "id": "tap_storage_tab",
          "action": "tap",
          "selector": "[role='dialog'] button:has-text('Lagerplätze')",
          "checks": [
            "visible",
            "element_from_point"
          ]
        },
        {
          "id": "save_created_article",
          "action": "tap",
          "selector": "[role='dialog'] button[type='submit'], [role='dialog'] button:has-text('Artikel speichern')",
          "checks": [
            "visible",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_create_dialog_closed",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": false,
          "timeout_ms": 8000
        },
        {
          "id": "assert_article_saved_in_table",
          "action": "assert",
          "selector": "button[aria-label='QA-ART-489-NAT bearbeiten'], table tr:has-text('QA-ART-489-NAT')",
          "expected_present": true,
          "timeout_ms": 8000,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "tap_row_edit_button",
          "action": "tap",
          "selector": "button[aria-label='QA-ART-489-NAT bearbeiten']",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_edit_sheet_open",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": true,
          "timeout_ms": 5000
        },
        {
          "id": "type_updated_title",
          "action": "type",
          "selector": "[role='dialog'] input[name='title']",
          "text": "QA-Flow 489 Native Artikel Editiert",
          "mutation": true,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "save_edited_article",
          "action": "tap",
          "selector": "[role='dialog'] button[type='submit'], [role='dialog'] button:has-text('Artikel speichern')",
          "checks": [
            "visible",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_edit_dialog_closed_after_save",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": false,
          "timeout_ms": 8000
        },
        {
          "id": "assert_edited_title_in_table",
          "action": "assert",
          "selector": "table",
          "expected_text": "QA-Flow 489 Native Artikel Editiert",
          "checks": [
            "visible"
          ]
        },
        {
          "id": "tap_row_edit_again_for_sheet_dismissal",
          "action": "tap",
          "selector": "button[aria-label='QA-ART-489-NAT bearbeiten']",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_sheet_open_for_dismissal",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": true,
          "timeout_ms": 5000
        },
        {
          "id": "dismiss_mobile_sheet_via_cdp_touch_swipe",
          "action": "swipe",
          "selector": "[role='dialog'] div.touch-none, [role='dialog'] > div.touch-none",
          "touch_only": true,
          "direction": "down",
          "distance": 450,
          "assert_dismissal": true,
          "checks": [
            "dismissed"
          ]
        },
        {
          "id": "close_desktop_sheet_via_close_button",
          "action": "tap",
          "selector": "[role='dialog'] button:has-text('Abbrechen'), [role='dialog'] button[aria-label='Schließen'], [role='dialog'] button:has-text('Schließen')",
          "desktop_only": true,
          "checks": [
            "visible",
            "element_from_point"
          ]
        },
        {
          "id": "assert_sheet_dismissed",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": false,
          "timeout_ms": 6000
        },
        {
          "id": "open_row_more_actions_menu",
          "action": "tap",
          "selector": "button[aria-label='Weitere Aktionen für QA-ART-489-NAT']",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        },
        {
          "id": "tap_delete_menu_item",
          "action": "tap",
          "selector": "[role='menuitem']:has-text('Artikel löschen'), [role='menu'] div:has-text('Artikel löschen')",
          "checks": [
            "visible",
            "element_from_point"
          ]
        },
        {
          "id": "assert_delete_confirm_dialog_open",
          "action": "assert",
          "selector": "[role='alertdialog'], [role='dialog']",
          "expected_present": true,
          "timeout_ms": 5000
        },
        {
          "id": "confirm_article_deletion",
          "action": "tap",
          "selector": "[role='alertdialog'] button:has-text('Artikel löschen'), [role='dialog'] button:has-text('Artikel löschen')",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_delete_dialog_closed",
          "action": "assert",
          "selector": "[role='dialog']:has-text('Artikel löschen'), [role='alertdialog']",
          "expected_present": false,
          "timeout_ms": 8000
        },
        {
          "id": "assert_article_deleted_from_table",
          "action": "assert",
          "selector": "button[aria-label='QA-ART-489-NAT bearbeiten']",
          "expected_present": false,
          "timeout_ms": 5000
        }
      ],
      "cleanup": [
        {
          "id": "cleanup_close_dialog_if_open",
          "action": "cleanup",
          "selector": "[role='dialog'] button:has-text('Abbrechen'), [role='dialog'] button[aria-label='Schließen'], [role='alertdialog'] button:has-text('Abbrechen')"
        },
        {
          "id": "cleanup_open_more_actions_if_row_exists",
          "action": "cleanup",
          "selector": "button[aria-label='Weitere Aktionen für QA-ART-489-NAT']",
          "then": "[role='menuitem']:has-text('Artikel löschen')"
        },
        {
          "id": "cleanup_confirm_delete_if_dialog_open",
          "action": "cleanup",
          "selector": "[role='alertdialog'] button:has-text('Artikel löschen'), [role='dialog'] button:has-text('Artikel löschen')"
        }
      ]
    },
    {
      "id": "article_row_edit_phone",
      "name": "Artikel-Zeilenbearbeitung auf dem Smartphone erreichbar",
      "description": "Prueft, ob in der Artikeltabelle auf dem Smartphone (390x844) eine sichtbare, erreichbare Bearbeiten-Aktion mit Mindest-Touch-Target vorhanden ist, ohne horizontales Scrollen zu erzwingen.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "delete_database",
        "drop_table",
        "ebay_publish"
      ],
      "steps": [
        {
          "id": "goto_products_page",
          "action": "goto",
          "url": "/products",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "tap_row_edit_action",
          "action": "tap",
          "selector": "table tbody tr:first-child button[aria-label*='bearbeiten'], table tbody tr:first-child button:has-text('Bearbeiten'), table tbody tr:first-child a[aria-label*='bearbeiten']",
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "assert_edit_sheet_open",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": true
        }
      ],
      "cleanup": [
        {
          "id": "cleanup_close_edit_dialog",
          "action": "cleanup",
          "selector": "[role='dialog'] button:has-text('Abbrechen'), [role='dialog'] button[aria-label='Schließen']"
        }
      ]
    },
    {
      "id": "offer_sheet_swipe_close",
      "name": "Angebotsdetail-Sheet per Swipe nach unten schliessen",
      "description": "Oeffnet ein eBay-Angebot in der mobilen Sheet-Ansicht und prueft, ob das Sheet per Swipe-Geste nach unten geschlossen werden kann.",
      "allowed_actions": [
        "goto",
        "tap",
        "swipe",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "delete_database",
        "ebay_publish",
        "purchase_label"
      ],
      "steps": [
        {
          "id": "goto_listings_page",
          "action": "goto",
          "url": "/listings",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "open_offer_detail_sheet",
          "action": "tap",
          "selector": "main ul > li button, main table tbody tr td button:not([role='checkbox'])",
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point"
          ]
        },
        {
          "id": "assert_sheet_present",
          "action": "assert",
          "selector": "[role='dialog']",
          "expected_present": true,
          "timeout_ms": 5000
        },
        {
          "id": "swipe_down_to_dismiss_sheet",
          "action": "swipe",
          "selector": "[role='dialog'] > div.touch-none",
          "touch_only": true,
          "direction": "down",
          "distance": 400,
          "assert_dismissal": true,
          "checks": [
            "dismissed"
          ]
        },
        {
          "id": "assert_sheet_dismissed_state",
          "action": "assert",
          "selector": "[role='dialog']",
          "touch_only": true,
          "expected_present": false
        }
      ],
      "cleanup": [
        {
          "id": "cleanup_close_sheet_fallback",
          "action": "cleanup",
          "selector": "[role='dialog'] button[aria-label='Close'], [role='dialog'] button[aria-label='Schließen'], [role='dialog'] button:has-text('Schließen')"
        }
      ]
    },
    {
      "id": "returns_tabs_same_row",
      "name": "Retouren-Filtertabs in einer Zeile ohne Reload",
      "description": "Prueft, dass die Status-Tabs auf /returns mobil in einer einzigen horizontal scrollbaren Zeile liegen (kein Umbruch ueber mehrere Zeilen) und Filterwechsel ohne Dokument-Reload erfolgen.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "delete_database",
        "create_external_return"
      ],
      "steps": [
        {
          "id": "goto_returns_page",
          "action": "goto",
          "url": "/returns",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "verify_status_tabs_container",
          "action": "assert",
          "selector": "[aria-label='Retouren filtern'], [data-testid='status-tabs']",
          "expected_present": true
        },
        {
          "id": "tap_tab_offen",
          "action": "tap",
          "selector": "[aria-label='Retouren filtern'] button:nth-child(2), button:has-text('Offen')",
          "no_document_reload": true,
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point",
            "no_document_reload"
          ]
        },
        {
          "id": "tap_tab_wartet",
          "action": "tap",
          "selector": "[aria-label='Retouren filtern'] button:nth-child(3), button:has-text('Wartet')",
          "no_document_reload": true,
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point",
            "no_document_reload"
          ]
        },
        {
          "id": "assert_returns_table_present",
          "action": "assert",
          "selector": "[aria-label='Retouren filtern']",
          "expected_present": true
        }
      ],
      "cleanup": []
    },
    {
      "id": "dhl_pdf_upload_stock",
      "name": "DHL-Label-PDF-Upload ohne Vorrats-Sackgasse",
      "description": "Prueft den Upload von DHL-Label-PDFs auf /labels bzw. /templates und stellt sicher, dass fehlende Labelvorraete automatisch angelegt werden statt in einer Fehlermeldungs-Sackgasse zu enden. Laedt das DHL-Common-Label-Beispiel (nur Fake-Daten) als QA-flow-dhl-sample hoch; im echten Konto entstehen dadurch Labels, daher loescht das Cleanup jede Datei QA-flow-dhl-sample* wieder.",
      "allowed_actions": [
        "goto",
        "tap",
        "upload",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "delete_database",
        "purchase_label",
        "confirm_ship"
      ],
      "steps": [
        {
          "id": "goto_labels_page",
          "action": "goto",
          "url": "/labels",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "verify_upload_control_present",
          "action": "assert",
          "selector": "button:has-text('DHL-PDF hochladen'), input[type='file'][accept*='pdf']",
          "expected_present": true
        },
        {
          "id": "upload_sample_dhl_pdf",
          "action": "upload",
          "selector": "input[type='file'][accept*='pdf']",
          "file": "workflows/portable/fixtures/QA-flow-dhl-sample.pdf",
          "checks": [
            "visible"
          ]
        },
        {
          "id": "assert_upload_handled_without_dead_end",
          "action": "assert",
          "selector": "[role='alert'], [data-sonner-toast], [role='status'], .text-destructive, h2:has-text('Labels')",
          "expected_present": true
        },
        {
          "id": "wait_until_upload_reported",
          "action": "assert",
          "selector": "[data-sonner-toast]",
          "expected_present": true,
          "timeout_ms": 30000
        }
      ],
      "cleanup": [
        {
          "id": "cleanup_reload_labels",
          "action": "goto",
          "url": "/labels"
        },
        {
          "id": "cleanup_delete_uploaded_qa_labels",
          "action": "cleanup",
          "selector": "button[aria-label^='QA-flow-dhl-sample']",
          "then": "[role='dialog'] button:has-text('Löschen')",
          "repeat": 12
        }
      ]
    },
    {
      "id": "order_edit_notes",
      "name": "Bestellung bearbeiten mit internen QA-Notizen",
      "description": "Oeffnet eine Bestellung, tippt eine interne Notiz mit QA-Praefix und prueft, dass der Speichern-Button erreichbar ist. Speichert nie: das Cleanup laedt /orders neu und verwirft den Text, die echte Notiz bleibt unveraendert.",
      "allowed_actions": [
        "goto",
        "tap",
        "type",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "ebay_write",
        "buy_label",
        "confirm_ship",
        "send_message",
        "delete_order"
      ],
      "steps": [
        {
          "id": "goto_orders_page",
          "action": "goto",
          "url": "/orders",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "open_first_order",
          "action": "tap",
          "selector": "main table tbody tr button:has-text('Kurzansicht'), main div.rounded-lg.border button.truncate",
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point"
          ]
        },
        {
          "id": "focus_order_notes_field",
          "action": "tap",
          "selector": "#order-notes, textarea[name='notes'], textarea[placeholder*='Notiz']",
          "checks": [
            "visible",
            "element_from_point"
          ]
        },
        {
          "id": "type_internal_qa_notes",
          "action": "type",
          "selector": "#order-notes, textarea[name='notes']",
          "text": "QA-Flow Testnotiz interne Pruefung",
          "mutation": true,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "assert_save_button_enabled_not_tapped",
          "action": "assert",
          "selector": "button:has-text('Notizen speichern')",
          "expected_present": true,
          "checks": [
            "visible",
            "tap_target_min_44"
          ]
        }
      ],
      "cleanup": [
        {
          "id": "cleanup_discard_unsaved_notes",
          "action": "goto",
          "url": "/orders"
        }
      ]
    },
    {
      "id": "packing_mode_scan",
      "name": "Packmodus Scannertest mit sicherem Halt vor Versandbestaetigung",
      "description": "Oeffnet den Packmodus, aktiviert den Scannertest ohne Buchung, fuehrt einen Testscan durch und stoppt strikt vor 'Versand bestaetigen' ohne externe Uebergabe oder eBay-Versandmeldung.",
      "allowed_actions": [
        "goto",
        "tap",
        "type",
        "assert",
        "cleanup"
      ],
      "forbidden_actions": [
        "confirm_ship",
        "mark_shipped",
        "buy_label",
        "ebay_write",
        "send_message",
        "eval"
      ],
      "steps": [
        {
          "id": "goto_shipping_runs_page",
          "action": "goto",
          "url": "/shipping-runs",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "open_pack_mode_view",
          "action": "goto",
          "url_from_link": {
            "selector": "main a[href*='/shipping-runs/']",
            "pattern": "/shipping-runs/(?:new\\?runId=)?([0-9a-f-]{36})",
            "template": "/shipping-runs/$1/pack"
          },
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "assert_scanner_input_present",
          "action": "assert",
          "selector": "input[placeholder*='Code scannen'], input[aria-label='Scancode']",
          "expected_present": true
        },
        {
          "id": "activate_scanner_test_mode",
          "action": "tap",
          "selector": "label:has-text('Scanner testen')",
          "checks": [
            "visible",
            "tap_target_min_44"
          ]
        },
        {
          "id": "enter_test_barcode_without_booking",
          "action": "type",
          "selector": "input[placeholder*='Code scannen'], input[aria-label='Scancode']",
          "text": "QA-SCAN-459-TEST",
          "mutation": true,
          "checks": [
            "visible"
          ]
        },
        {
          "id": "assert_scanner_test_notice",
          "action": "assert",
          "selector": "main, [role='status'], p:has-text('Scannertest')",
          "expected_present": true
        },
        {
          "id": "stop_strictly_before_ship_confirmation",
          "action": "assert",
          "selector": "button:has-text('Versand bestätigen'), [data-testid='confirm-ship']",
          "expected_present": false
        }
      ],
      "cleanup": []
    }
  ]
}
