{
  "schema": "flow-qa/v1",
  "project": "polysimulator",
  "version": "1.0.0",
  "description": "Staging-only Flow QA definitions for PolySimulator covering markets navigation, trade panel interaction, and order book/activity tabs without document reload.",
  "viewports": [
    "390x844",
    "390x420",
    "1440x900"
  ],
  "themes": [
    "light",
    "dark"
  ],
  "flows": [
    {
      "id": "markets_navigation_and_filters",
      "name": "Maerkte-Uebersicht und Kategorie-Navigation",
      "description": "Loads the PolySimulator markets list, checks the feed renders, and taps the Sort control without a document reload.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert"
      ],
      "forbidden_actions": [
        "eval",
        "delete_database",
        "prod_access"
      ],
      "steps": [
        {
          "id": "goto_markets_page",
          "action": "goto",
          "url": "/markets",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "dismiss_consent_banner",
          "action": "tap",
          "selector": "[aria-labelledby='consent-title'] button",
          "optional": true
        },
        {
          "id": "assert_market_feed_present",
          "action": "assert",
          "selector": "main a[href^='/markets/']",
          "expected_present": true
        },
        {
          "id": "open_sort_control",
          "action": "tap",
          "selector": "button[aria-label='Sort markets']",
          "no_document_reload": true,
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point",
            "no_document_reload"
          ]
        },
        {
          "id": "assert_filtered_markets_container",
          "action": "assert",
          "selector": "main",
          "expected_present": true
        }
      ],
      "cleanup": []
    },
    {
      "id": "market_trade_panel_interaction",
      "name": "Markt-Detailseite und Trade-Panel Eingabemaske",
      "description": "Opens a market detail page, focuses the amount field with the keyboard open, types 1 and checks the shares preview updates. The order is never submitted.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert",
        "keyboard-open",
        "type",
        "cleanup"
      ],
      "forbidden_actions": [
        "eval",
        "real_money_transaction",
        "prod_access",
        "delete_database"
      ],
      "steps": [
        {
          "id": "goto_markets_overview",
          "action": "goto",
          "url": "/markets",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "dismiss_consent_banner",
          "action": "tap",
          "selector": "[aria-labelledby='consent-title'] button",
          "optional": true
        },
        {
          "id": "open_first_market_detail",
          "action": "tap",
          "selector": "main a[aria-label][href^='/markets/']",
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point"
          ]
        },
        {
          "id": "assert_trade_panel_visible",
          "action": "assert",
          "selector": "input[type='number']",
          "expected_present": true
        },
        {
          "id": "open_mobile_trade_drawer",
          "action": "tap",
          "selector": "[data-testid='sticky-buy-up-btn']",
          "optional": true,
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point"
          ]
        },
        {
          "id": "open_amount_sheet",
          "action": "tap",
          "selector": "[data-testid='sticky-open-sheet-edit']",
          "optional": true,
          "checks": [
            "tap_target_min_44"
          ]
        },
        {
          "id": "focus_amount_field",
          "action": "keyboard-open",
          "selector": "input[type='number']",
          "checks": [
            "input_focus_in_viewport"
          ]
        },
        {
          "id": "type_numeric_amount",
          "action": "type",
          "selector": "input[type='number']",
          "text": "1",
          "numeric_only": true,
          "preview_regex": "≈\\s*([\\d.,]+)\\s*shares"
        }
      ],
      "cleanup": []
    },
    {
      "id": "order_book_and_activity_tabs",
      "name": "Detail tabs without page reload",
      "description": "Opens a market detail page and switches between the Comments and Activity tabs without a document reload.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert"
      ],
      "forbidden_actions": [
        "eval",
        "prod_access",
        "delete_database"
      ],
      "steps": [
        {
          "id": "goto_markets_list",
          "action": "goto",
          "url": "/markets",
          "checks": [
            "visible",
            "no_horizontal_overflow"
          ]
        },
        {
          "id": "dismiss_consent_banner",
          "action": "tap",
          "selector": "[aria-labelledby='consent-title'] button",
          "optional": true
        },
        {
          "id": "open_market_item",
          "action": "tap",
          "selector": "main a[aria-label][href^='/markets/']",
          "checks": [
            "visible",
            "tap_target_min_44"
          ]
        },
        {
          "id": "switch_to_comments_tab",
          "action": "tap",
          "selector": "button[role='tab']:first-of-type",
          "no_document_reload": true,
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point",
            "no_document_reload"
          ]
        },
        {
          "id": "switch_to_activity_tab",
          "action": "tap",
          "selector": "button[role='tab']:last-of-type",
          "no_document_reload": true,
          "checks": [
            "visible",
            "tap_target_min_44",
            "element_from_point",
            "no_document_reload"
          ]
        },
        {
          "id": "assert_activity_feed_present",
          "action": "assert",
          "selector": "table, [data-testid='trades-list'], main"
        }
      ],
      "cleanup": []
    }
  ]
}
