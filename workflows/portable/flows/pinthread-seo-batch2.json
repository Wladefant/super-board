{
  "schema": "flow-qa/v1",
  "project": "pinthread-seo-batch2",
  "version": "1.0.0",
  "description": "Flow QA for the pinthread.dev marketing site and docs (packages/pinthread-site). Covers the sign-up path from the landing page and pricing, the install tabs, the copy buttons, the MCP tabs and the docs navigation menu. Read-only: the site has no data mutations. Serve the built dist with a server that answers /api/version from the pinthread-build meta tag. Batch 2 adds the SEO pages /mcp-server/, /free-website-feedback-tool/, /alternatives/, /alternatives/marker-io/ and /alternatives/bugherd/.",
  "viewports": [
    "390x844",
    "390x420",
    "1440x900"
  ],
  "themes": [
    "light",
    "dark"
  ],
  "flows": [
    {
      "id": "landing_to_signup",
      "name": "Find the price and the sign-up button",
      "description": "Opens the landing page, checks the header sign-up button, jumps to pricing, checks the Free plan at $0 and taps its sign-up button, which opens the dashboard sign-in page.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert"
      ],
      "forbidden_actions": [
        "eval",
        "prod_access"
      ],
      "steps": [
        {
          "id": "goto_home",
          "action": "goto",
          "url": "/"
        },
        {
          "id": "assert_header_signup",
          "action": "assert",
          "selector": "a.lp-header-cta[href='/dashboard/']",
          "expected_text": "Sign up free",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_no_early_access",
          "action": "assert",
          "selector": "a[href*='early-access'], a[href*='waitlist']",
          "expected_present": false
        },
        {
          "id": "tap_pricing_nav",
          "action": "tap",
          "selector": "a.lp-nav-wide[href='#pricing']",
          "optional": true,
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "no_document_reload"
          ]
        },
        {
          "id": "goto_pricing",
          "action": "goto",
          "url": "/#pricing"
        },
        {
          "id": "assert_free_price",
          "action": "assert",
          "selector": ".lp-plan-featured .lp-plan-amount",
          "expected_text": "$0"
        },
        {
          "id": "assert_free_limits",
          "action": "assert",
          "selector": ".lp-plan-featured ul",
          "expected_text": "10 projects"
        },
        {
          "id": "assert_plan_signup",
          "action": "assert",
          "selector": ".lp-plan-featured a.lp-plan-cta[href='/dashboard/']",
          "expected_text": "Get started free"
        },
        {
          "id": "tap_plan_signup",
          "action": "tap",
          "selector": ".lp-plan-featured a.lp-plan-cta[href='/dashboard/']",
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44"
          ]
        }
      ],
      "cleanup": []
    },
    {
      "id": "install_script_tag",
      "name": "Pick a setup and copy the script tag",
      "description": "Opens Install, switches through the four setup tabs without a reload, and taps a copy button.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert"
      ],
      "forbidden_actions": [
        "eval",
        "prod_access"
      ],
      "steps": [
        {
          "id": "goto_install",
          "action": "goto",
          "url": "/install/"
        },
        {
          "id": "assert_signup_link",
          "action": "assert",
          "selector": "main a[href='/dashboard/']",
          "expected_text": "Sign up"
        },
        {
          "id": "tap_tab_nextjs",
          "action": "tap",
          "selector": "#install-tab-1",
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44",
            "no_document_reload"
          ]
        },
        {
          "id": "assert_tab_nextjs",
          "action": "assert",
          "selector": "#install-tab-1[aria-selected='true']",
          "expected_present": true
        },
        {
          "id": "tap_tab_astro",
          "action": "tap",
          "selector": "#install-tab-2",
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44",
            "no_document_reload"
          ]
        },
        {
          "id": "tap_tab_builders",
          "action": "tap",
          "selector": "#install-tab-3",
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44",
            "no_document_reload"
          ]
        },
        {
          "id": "tap_tab_html",
          "action": "tap",
          "selector": "#install-tab-0",
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44",
            "no_document_reload"
          ]
        },
        {
          "id": "assert_embed_src",
          "action": "assert",
          "selector": "#install-panel-0",
          "expected_text": "https://pinthread.dev/embed.js"
        },
        {
          "id": "tap_copy",
          "action": "tap",
          "selector": "#install-panel-0 .copy-btn",
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44",
            "no_document_reload"
          ]
        }
      ],
      "cleanup": []
    },
    {
      "id": "agent_mcp_setup",
      "name": "Connect a coding agent over MCP",
      "description": "Opens For your agent, switches the MCP client tabs and checks the remote MCP URL.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert"
      ],
      "forbidden_actions": [
        "eval",
        "prod_access"
      ],
      "steps": [
        {
          "id": "goto_agent",
          "action": "goto",
          "url": "/agent-prompts/"
        },
        {
          "id": "assert_mcp_url",
          "action": "assert",
          "selector": "#mcp",
          "expected_text": "https://pinthread.dev/mcp"
        },
        {
          "id": "tap_mcp_codex",
          "action": "tap",
          "selector": "#mcp-tab-1",
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44",
            "no_document_reload"
          ]
        },
        {
          "id": "assert_mcp_codex",
          "action": "assert",
          "selector": "#mcp-tab-1[aria-selected='true']",
          "expected_present": true
        },
        {
          "id": "tap_mcp_cursor",
          "action": "tap",
          "selector": "#mcp-tab-2",
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44",
            "no_document_reload"
          ]
        },
        {
          "id": "tap_mcp_other",
          "action": "tap",
          "selector": "#mcp-tab-3",
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44",
            "no_document_reload"
          ]
        }
      ],
      "cleanup": []
    },
    {
      "id": "docs_navigation",
      "name": "Open and close the docs menu",
      "description": "On phones, opens the docs navigation, checks the sign-up link inside it and closes it again. On desktop the sidebar is always visible.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert"
      ],
      "forbidden_actions": [
        "eval",
        "prod_access"
      ],
      "steps": [
        {
          "id": "goto_configuration",
          "action": "goto",
          "url": "/configuration/"
        },
        {
          "id": "assert_branch_attr",
          "action": "assert",
          "selector": "main",
          "expected_text": "data-branch"
        },
        {
          "id": "open_menu",
          "action": "tap",
          "selector": ".nav-toggle[aria-expanded='false']",
          "optional": true,
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "tap_target_min_44",
            "no_document_reload"
          ]
        },
        {
          "id": "assert_sidebar_signup",
          "action": "assert",
          "selector": ".sidebar-cta[href='/dashboard/']",
          "expected_text": "Get started free",
          "checks": [
            "visible",
            "element_from_point"
          ]
        },
        {
          "id": "close_menu",
          "action": "tap",
          "selector": ".nav-toggle[aria-expanded='true']",
          "optional": true,
          "no_document_reload": true,
          "checks": [
            "visible",
            "no_document_reload"
          ]
        }
      ],
      "cleanup": []
    },
    {
      "id": "seo_mcp_server",
      "name": "Read the MCP server page and switch clients",
      "description": "Opens /mcp-server/, checks the H1, the tool table and the dated rival table, switches the MCP client tabs, opens an FAQ answer.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert"
      ],
      "forbidden_actions": [
        "eval",
        "prod_access"
      ],
      "steps": [
        {
          "id": "goto_mcp_server",
          "action": "goto",
          "url": "/mcp-server/"
        },
        {
          "id": "assert_h1",
          "action": "assert",
          "selector": "main h1",
          "expected_text": "A website feedback MCP server",
          "checks": [
            "visible"
          ]
        },
        {
          "id": "assert_url",
          "action": "assert",
          "selector": "#connect",
          "expected_text": "https://pinthread.dev/mcp"
        },
        {
          "id": "tap_tab_codex",
          "action": "tap",
          "selector": "#mcp-tab-1",
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "no_document_reload",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_tab_codex",
          "action": "assert",
          "selector": "#mcp-tab-1[aria-selected='true']",
          "expected_present": true
        },
        {
          "id": "tap_tab_cursor",
          "action": "tap",
          "selector": "#mcp-tab-2",
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "no_document_reload",
            "tap_target_min_44"
          ]
        },
        {
          "id": "assert_tools",
          "action": "assert",
          "selector": "#tools",
          "expected_text": "reopen_thread"
        },
        {
          "id": "assert_rival_date",
          "action": "assert",
          "selector": "#compare",
          "expected_text": "Checked on 7 October 2026"
        },
        {
          "id": "open_faq",
          "action": "tap",
          "selector": "#faq details:first-of-type summary",
          "no_document_reload": true,
          "checks": [
            "visible",
            "element_from_point",
            "no_document_reload"
          ]
        },
        {
          "id": "assert_faq_open",
          "action": "assert",
          "selector": "#faq details[open]",
          "expected_present": true
        }
      ],
      "cleanup": []
    },
    {
      "id": "seo_free_page",
      "name": "Check the free plan and sign up",
      "description": "Opens /free-website-feedback-tool/, checks the plan limits from plans.json and the dated free-tier table, then taps the sign-up link to the dashboard.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert"
      ],
      "forbidden_actions": [
        "eval",
        "prod_access"
      ],
      "steps": [
        {
          "id": "goto_free",
          "action": "goto",
          "url": "/free-website-feedback-tool/"
        },
        {
          "id": "assert_h1",
          "action": "assert",
          "selector": "main h1",
          "expected_text": "A free website feedback tool your agent can read",
          "checks": [
            "visible"
          ]
        },
        {
          "id": "assert_projects",
          "action": "assert",
          "selector": "#plan",
          "expected_text": "Up to 10 projects"
        },
        {
          "id": "assert_comments",
          "action": "assert",
          "selector": "#plan",
          "expected_text": "10,000 comments per project"
        },
        {
          "id": "assert_storage",
          "action": "assert",
          "selector": "#plan",
          "expected_text": "100 MB of storage per project"
        },
        {
          "id": "assert_table",
          "action": "assert",
          "selector": "#compare",
          "expected_text": "Checked on 7 October 2026"
        },
        {
          "id": "tap_signup",
          "action": "tap",
          "selector": "main a.doc-cta[href='/dashboard/']",
          "expected_url": "^/dashboard/",
          "checks": [
            "visible",
            "element_from_point"
          ]
        }
      ],
      "cleanup": []
    },
    {
      "id": "seo_alternatives_hub",
      "name": "Pick a comparison from the hub",
      "description": "Opens /alternatives/, checks the dated table, taps through to the Marker.io page.",
      "allowed_actions": [
        "goto",
        "tap",
        "assert"
      ],
      "forbidden_actions": [
        "eval",
        "prod_access"
      ],
      "steps": [
        {
          "id": "goto_hub",
          "action": "goto",
          "url": "/alternatives/"
        },
        {
          "id": "assert_h1",
          "action": "assert",
          "selector": "main h1",
          "expected_text": "Website feedback tools, compared",
          "checks": [
            "visible"
          ]
        },
        {
          "id": "assert_table",
          "action": "assert",
          "selector": "#plans",
          "expected_text": "BugHerd"
        },
        {
          "id": "assert_date",
          "action": "assert",
          "selector": "#plans",
          "expected_text": "Checked on 7 October 2026"
        },
        {
          "id": "tap_marker",
          "action": "tap",
          "selector": "#comparisons .page-links a[href='/alternatives/marker-io/']",
          "expected_url": "^/alternatives/marker-io/",
          "checks": [
            "visible",
            "element_from_point"
          ]
        },
        {
          "id": "assert_marker_h1",
          "action": "assert",
          "selector": "main h1",
          "expected_text": "A free alternative to Marker.io",
          "checks": [
            "visible"
          ]
        }
      ],
      "cleanup": []
    },
