{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuperboardFeatureMap",
  "description": "Schema for machine-readable feature map used for agent navigation",
  "type": "object",
  "required": [
    "version",
    "features"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "description",
          "entry_files",
          "tests",
          "owning_issue",
          "risk"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "entry_files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "owning_issue": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cli_command": {
            "type": "string"
          },
          "docs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
