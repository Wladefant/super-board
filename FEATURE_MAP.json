{
  "$schema": "workflows/portable/feature_map.schema.json",
  "version": "1.0.0",
  "repository": "Wladefant/super-board",
  "description": "Machine-readable feature map for agent navigation in super-board",
  "features": {
    "idea-intake": {
      "name": "Single-sentence Idea Intake",
      "description": "Draft, independently judge, lint and rewrite issues before explicit filing.",
      "entry_files": [
        "scripts/super-board-idea.py",
        "scripts/super_board_runtime/idea.py"
      ],
      "tests": [
        "tests/test_idea_intake.py",
        "tests/test_intake_normalizer.py"
      ],
      "owning_issue": "https://github.com/Wladefant/super-board/issues/2",
      "risk": "low",
      "cli_command": "python scripts/super-board-idea.py --help",
      "docs": [
        "skills/super-board/references/idea.md"
      ]
    },
    "routing": {
      "name": "Model Routing & Usage Telemetry",
      "description": "Calibrated model routing ladders, role-to-model pins, provider pacing, allowance tracking, and fallback policies for agent lanes.",
      "entry_files": [
        "workflows/portable/model_routing.py",
        "workflows/portable/balance_loader.py",
        "workflows/portable/quota_snapshot.py"
      ],
      "tests": [
        "workflows/portable/routing_smoke_test.py",
        "workflows/portable/test_quota_snapshot.py"
      ],
      "owning_issue": "https://github.com/Wladefant/super-board/issues/210",
      "risk": "high",
      "components": [
        "ModelRouter",
        "RoleModelPins",
        "PacingGuard",
        "QuotaTracker"
      ],
      "cli_command": "python -B workflows/portable/routing_smoke_test.py",
      "docs": [
        "workflows/portable/PORTABLE.md"
      ]
    },
    "gate": {
      "name": "Pull Request Gate & Content-Bound Review",
      "description": "GitHub PR qualification, content-bound review verification (patch-id and diff sha256), approval waivers, and deploy-critical CI checks.",
      "entry_files": [
        "workflows/portable/github_pr_gate.py",
        "workflows/portable/review_content.py",
        "workflows/portable/github_work_item.py"
      ],
      "tests": [
        "workflows/portable/test_github_pr_gate.py",
        "workflows/portable/test_review_content.py",
        "workflows/portable/test_review_content_gate.py",
        "workflows/portable/test_github_work_item.py"
      ],
      "owning_issue": "https://github.com/Wladefant/super-board/issues/195",
      "risk": "high",
      "components": [
        "GitHubPrGate",
        "ContentBoundReview",
        "ReviewFreshnessCheck",
        "DeployCriticalChecks"
      ],
      "cli_command": "python -B workflows/portable/test_github_pr_gate.py"
    },
    "ledger": {
      "name": "Durable Request Ledger & Gates",
      "description": "Machine-local crash-resilient request ledger, state machine transitions, acceptance criteria tracking, and synchronization with GitHub Issues / Project 5.",
      "entry_files": [
        "workflows/portable/ledger.py",
        "workflows/portable/superboard_adapter.py",
        "workflows/portable/project_adapter.py"
      ],
      "tests": [
        "workflows/portable/test_ledger_gates.py",
        "workflows/portable/test_superboard_adapter.py",
        "workflows/portable/test_project_adapter.py"
      ],
      "owning_issue": "https://github.com/Wladefant/super-board/issues/74",
      "risk": "medium",
      "components": [
        "RequestLedger",
        "SuperboardAdapter",
        "ProjectAdapter",
        "StateTransitionGate"
      ],
      "cli_command": "python -B workflows/portable/test_ledger_gates.py"
    },
    "gardener": {
      "name": "Gardener Code Pruning & Debt Weeding",
      "description": "Automated scans for dead code, unused exports, and tech debt (Knip for TypeScript, Vulture for Python) with bounded cleanup task specification generation.",
      "entry_files": [
        "workflows/portable/gardener.py"
      ],
      "tests": [
        "workflows/portable/test_gardener.py"
      ],
      "owning_issue": "https://github.com/Wladefant/super-board/issues/227",
      "risk": "low",
      "components": [
        "GardenerRunner",
        "KnipScanner",
        "VultureScanner",
        "CleanupTaskSpecGenerator"
      ],
      "cli_command": "python -B workflows/portable/test_gardener.py"
    },
    "depth_survey": {
      "name": "Gardener Module Depth Survey",
      "description": "Report-only survey of shallow modules in hot files with a deletion test per candidate and an offline single-file HTML report. Run with gardener.py --survey-depth.",
      "entry_files": [
        "workflows/portable/depth_survey.py",
        "workflows/portable/gardener.py",
        "skills/improve-codebase-architecture/SKILL.md"
      ],
      "tests": [
        "workflows/portable/test_depth_survey.py"
      ],
      "owning_issue": "https://github.com/Wladefant/super-board/issues/510",
      "risk": "low",
      "components": [
        "DepthSurvey",
        "DeletionTest",
        "OfflineReport"
      ],
      "cli_command": "python -B workflows/portable/test_depth_survey.py"
    },
    "build_slot": {
      "name": "Build & Browser Slot Arbiter",
      "description": "Host-level resource arbiter managing exclusive access to heavy tasks (next build, dev Chromium) with FIFO queuing, RAM threshold guards, and stale lock reclamation.",
      "entry_files": [
        "workflows/portable/build_slot.py"
      ],
      "tests": [
        "workflows/portable/test_build_slot.py"
      ],
      "owning_issue": "https://github.com/Wladefant/super-board/issues/227",
      "risk": "medium",
      "components": [
        "BuildSlotManager",
        "RamGuard",
        "FifoQueue",
        "StaleLockReclaimer"
      ],
      "cli_command": "python -B workflows/portable/test_build_slot.py"
    },
    "polysim_next_cache": {
      "name": "PolySimulator Next Build Cache",
      "description": "Per-worktree .next/cache for PolySimulator QA builds: replaces shared-cache junctions, drops webpack packs keyed to other worktrees, seeds and warms .tsbuildinfo from the nearest prepared worktree, and sweeps idle worktrees.",
      "entry_files": [
        "workflows/portable/polysim_next_cache.py",
        "workflows/portable/wt_remove.py"
      ],
      "tests": [
        "workflows/portable/test_polysim_next_cache.py"
      ],
      "owning_issue": "https://github.com/Wladefant/super-board/issues/321",
      "risk": "medium",
      "components": [
        "prepare",
        "sweep",
        "seed_tsbuildinfo",
        "rank_sources"
      ],
      "cli_command": "python -B workflows/portable/test_polysim_next_cache.py"
    },
    "telegram-outbound-media": {
      "name": "Telegram outbound media",
      "description": "Agent-facing photos, PDFs, and generic documents routed to the bound Telegram chat and forum topic",
      "entry_files": [
        "packages/telegram-agent-harness/extension/index.ts",
        "packages/telegram-agent-harness/extension/outbound-media.ts",
        "packages/telegram-agent-harness/extension/poller.ts"
      ],
      "tests": [
        "packages/telegram-agent-harness/tests/outbound-media.test.ts",
        "packages/telegram-agent-harness/tests/a-telegram-tool-serves-only-the-session-that-owns-it.test.ts"
      ],
      "owning_issue": "https://github.com/Wladefant/super-board/issues/344",
      "risk": "medium",
      "components": [
        "telegram_attachment",
        "TelegramPoller"
      ]
    },
    "telegram-session-controls": {
      "name": "Telegram session controls",
      "description": "Signed operator-only Stop confirmation, force-reply Steer and Follow-up, and labelled question answers with audit rows",
      "entry_files": [
        "packages/telegram-agent-harness/daemon/lane-panel.ts",
        "packages/telegram-agent-harness/daemon/runtime.ts"
      ],
      "tests": [
        "packages/telegram-agent-harness/tests/lane-panel.test.ts",
        "packages/telegram-agent-harness/tests/poller-signed-controls.test.ts",
        "packages/telegram-agent-harness/tests/question-answer-controls.test.ts"
      ],
      "owning_issue": "https://github.com/Wladefant/super-board/issues/431",
      "risk": "high"
    },
    "e2e": {
      "name": "Agentic e2e tests (tester-army/e2e)",
      "description": "Pinned e2e runner with cached replay, host allow-list with request-level abort, FLOW-QA receipt, managed e2e skill.",
      "entry_files": [
        "workflows/e2e/e2e_run.py",
        "workflows/e2e/e2e_receipt.py",
        "workflows/e2e/e2e_guard.py",
        "workflows/e2e/e2e.config.template.ts",
        "managed-skills/e2e/SKILL.md"
      ],
      "tests": [
        "workflows/e2e/test_e2e.py"
      ],
      "owning_issue": "473",
      "risk": "medium",
      "docs": [
        "workflows/e2e/POLICY.md"
      ]
    },
    "merge-first": {
      "name": "Temporary Merge-First Policy & Deployed FLOW-QA",
      "description": "Temporary merge-first default order (SUPERBOARD_MERGE_FIRST=1), post-deploy FLOW-QA verification, revert instruction emission, and merge guard enforcement.",
      "entry_files": [
        "workflows/portable/merge_policy.py",
        "workflows/portable/merge_guard.py",
        "workflows/portable/post_deploy_qa.py"
      ],
      "tests": [
        "workflows/portable/test_merge_policy.py",
        "workflows/portable/test_merge_guard.py",
        "workflows/portable/test_post_deploy_qa.py"
      ],
      "owning_issue": "https://github.com/Wladefant/super-board/issues/736",
      "risk": "medium",
      "components": [
        "merge_first_enabled",
        "MergeGuard",
        "PostDeployQA"
      ],
      "cli_command": "python -B workflows/portable/post_deploy_qa.py --help",
      "docs": [
        "workflows/portable/PORTABLE.md"
      ]
    }
  }
}
