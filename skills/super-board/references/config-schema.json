// Reference documentation for the Superboard config contract.
//
// The EXECUTABLE contract is `scripts/super_board_runtime/config.py`
// (`load_and_validate_config`). This file explains it for humans; where the two
// ever disagree, config.py wins and this file is the bug. Validate a real
// config with:
//
//     python scripts/super-board-config.py validate --config <path> --json
//
// This file is a REFERENCE DOC, not parsed at runtime. It uses JSON5-style `//`
// line comments to inline field notes. Strip comments before validating an
// actual config file as JSON.
//
// One config per GitHub project this repo drives, written to
// `.claude/super-board/configs/<slug>.json` (committed). The active
// pointer `.claude/super-board/active` is gitignored and per-machine.
//
// There is NO `columns` key. The lifecycle is fixed at seven statuses —
// Backlog · Ready · Building · QA · Review · Blocked · Done — and is not
// configurable. `Skipped` is not a status; a config that names it anywhere a
// lifecycle value is accepted exits 65.

{
  "version": 1,

  // Short scannable label shown when multiple configs are listed.
  // E.g. "staging QA" or "admin build pipeline".
  "description": "<short scannable label, e.g. 'staging QA' or 'admin build pipeline'>",

  "project": {
    "owner": "<github-owner>",
    "title": "<project title on GitHub>",
    // Required; `gh project` CLI takes number, not title (titles aren't unique).
    "number": 0
  },

  // "full" or "qa-only". Selects which lanes exist, NOT which statuses exist.
  "variant": "qa-only",

  // Worker dispatch backend. Default "claude-p" — the headless dispatcher
  // `.claude/bin/super-board-run.sh`. "workflow" drains waves in-session via
  // the super-board-wave dynamic workflow (references/run-workflow.md) and
  // requires dynamic workflows enabled in /config.
  "worker_backend": "claude-p",

  // Default model ladder for lane workers, indexed by card complexity from
  // the classify router. Overridden per run by `super-board run --low|--high`.
  //   "low"    — haiku (low) / sonnet (medium) / opus (high)
  //   "medium" — (default) sonnet / opus / session model
  //   "high"   — opus floor; medium+ inherit the session model
  "model_tier": "medium",

  "target": {
    // "url" | "repo" | "repo+url". Tells the runner whether to clone, hit a
    // URL, or both.
    "type": "url",
    "url": "<https://your-target-url.example.com>"
  },

  // `null` for URL-only; `{path, remote}` otherwise. `remote` is `owner/name`
  // (a github.com URL is accepted and normalized) or `null` for local-only.
  // Required when `activation_mode` is "proof-only", because the allowlisted
  // issue must be proven to live inside this repository.
  "repo": null,

  // The branch all per-issue branches are cut from and rebase-merged back into
  // BY A HUMAN. Defaults to `"main"`; onboard warns and suggests `"staging"` or
  // `"develop"` when `main` appears to be production, which is why the shipped
  // PolySimulator shape below runs on a `staging` default.
  "base_branch": "staging",

  // Optional label → branch VALIDATION TABLE. It does not choose a branch, and
  // this entry used to claim it did ("branched from that branch instead of
  // `base_branch`") — a promise `resolve_branch_route` has never kept and must
  // not keep, because a table that silently retargets work would be a second
  // routing authority beside the declaration, and the more permissive of two
  // authorities is the one that acts.
  //
  // The ROUTE is what the issue body declares — `Branch route: staging` or
  // `Branch route: staging-frankfurt`, exactly once — and the declaration IS
  // the base branch. Those two are the only declarations that resolve.
  //
  // What this table is for, and all it is for:
  //
  //   1. Redundancy. The Frankfurt route is a separate deploying branch, so it
  //      must be stated in the body AND carried on the card
  //      (`branch:staging-frankfurt`) before a branch is created. The label
  //      listed here is the half of that statement the card carries.
  //   2. Conflict detection. Two route labels naming different branches is a
  //      routing error (`route-label-conflict`), not a coin toss.
  //   3. Refusal. A label mapped onto a branch that can never dispatch —
  //      a repository default (`main` / `master`) or a design branch
  //      (`designstaging`) — makes the card ineligible with
  //      `route-declaration-unknown`, however the branch is spelled. Listing
  //      one here therefore buys a label that can never resolve.
  //
  // See `scripts/super_board_runtime/routing.py`, which is the authority.
  "branch_routes": {
    "branch:staging-frankfurt": "staging-frankfurt"
  },

  "paths": {
    // `null` when no PROJECT.md exists (URL-only flows).
    "project_md": null,
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },

  // The runtime NEVER merges. Reviewer marks the PR ready; a human merges it.
  // Default `true`, and there is no supported way to make the runtime merge.
  "human_approves_merge": true,

  // How the human merges. Only "rebase" is accepted: every commit must survive
  // on trunk so the TDD breadcrumb trail stays intact. "squash" and "merge"
  // exit 65.
  "merge_method": "rebase",

  // Dispatch activation. Exactly three modes, and nothing at runtime can
  // bypass them:
  //   "off"        — nothing is ever dispatched. `proof_issue_url` MUST be null.
  //   "proof-only" — only the single allowlisted issue may be selected.
  //                  `proof_issue_url` MUST be an exact issue URL inside `repo.remote`,
  //                  and that issue must be OPEN.
  //   "active"     — normal dispatch; eligibility rules still apply.
  //                  `proof_issue_url` MUST be null.
  "activation_mode": "off",
  "proof_issue_url": null,

  // Labels that can never be dispatched. `design` (human-designer-owned) and
  // `history` (archive, not work) are ALWAYS excluded whether listed here or
  // not; anything listed here is added to them. Comparison is case-insensitive
  // after trimming, and it is enforced in every dispatcher path — the planner,
  // the shell dispatcher, and the dynamic workflow.
  "exclude_labels": ["design", "history"],

  // GitHub identity contract. Values are NEVER stored here — only env var
  // NAMES. A config carrying anything that looks like credential material
  // exits 65.
  //   mode: "interactive" (the signed-in session identity) or "unattended".
  //   Unattended mutation accepts ONLY a machine-account CLASSIC PAT read from
  //   SUPERBOARD_GITHUB_TOKEN, whose login must equal SUPERBOARD_GITHUB_LOGIN,
  //   carrying scopes repo, project, read:org.
  //   Fine-grained PATs and GitHub App installation tokens are rejected:
  //   GitHub Apps cannot access personal Projects v2 at all.
  "github_auth": {
    "mode": "interactive",
    "token_env_var": "SUPERBOARD_GITHUB_TOKEN",
    "login_env_var": "SUPERBOARD_GITHUB_LOGIN",
    "expected_login": null,
    "required_scopes": ["repo", "project", "read:org"],
    // Extra Projects v2 boards the identity must be able to read, each checked
    // as its own capability.
    "required_projects": []
  },

  // The design skill's card contract. `design` cards are human-designer-owned;
  // agents never dispatch or edit them.
  "design_skill": { "enabled": true, "label": "design" },

  // Agent Native is projection only — it owns no work state, holds no mutation
  // credential, and executes no repository code. `projection_only: false`
  // exits 65.
  "agent_native": { "enabled": false, "projection_only": true },

  // Deployment context surfaced to workers. The runtime never deploys.
  "deploy": { "provider": null, "auto_deploy": false },

  // Immutable GraphQL reserve, in points. May be RAISED above 1000; lowering it
  // exits 65. When `remaining - estimated_cost` would fall below it, the
  // operation stops (exit 75) — no sleep-through-reset, no retry loop, no
  // fabricated fallback capacity.
  "minimum_graphql_reserve": 1000,

  // Controls Reviewer's adversarial mode (folded-in super-truth pattern).
  //   "off"          — never adversarial.
  //   "non-trivial"  — (default) activates on cards with diff ≥10 lines OR
  //                    labels in {security, migration, payments, auth}.
  //   "always"       — every card gets adversarial review
  //                    (cost: 2 sub-agent dispatches per card).
  "truth_gate": "non-trivial",

  // Minimum aggregated sub-agent confidence (0-100) required to approve.
  // Default `70`. Below threshold, Reviewer must NOT approve; card moves to
  // Blocked with `🛡 truth-check failed (confidence X/100)`.
  "truth_threshold": 70,

  // Max consecutive failures in the same lane on the same root-cause hash
  // before the card auto-moves to Blocked. Default `2`.
  "rebuild_cap": 2,

  // Consecutive expensive ticks with zero Done-count increase before halt.
  // Fires independent of lane occupancy (catches zero-merge token runaways).
  // Default `10`.
  "noprogress_halt_ticks": 10,

  // Hard per-run ceiling: max worker dispatches before graceful halt + drain.
  // Default `20`.
  "max_dispatches": 20,

  // Hard per-run ceiling: wall-clock hours before graceful halt + drain.
  // Default `3`.
  "max_hours": 3,

  // Max concurrent lane workers. Default `3`.
  "max_workers": 3,

  // Windows/MSYS only: when a lock PID is unverifiable via kill -0, treat the
  // lock as alive until this many seconds of age, then reap on elapsed time.
  // Default `900` (15 min). Unused on Linux/macOS (kill -0 is reliable there).
  "stale_lock_seconds": 900,

  // When the count of Blocked cards exceeds this percent of the initial Ready
  // count, send a mid-run breakdown notification. Default `30`. Set to `0`
  // to disable.
  "block_rate_alert_pct": 30,

  "notifications": {
    // Auto-detected during onboard; can be overridden.
    "channel": "telegram",
    "chat_id": "auto",

    // The assignee identity used as the claim mutex. Read by
    // `super-board status` and `super-board run`. Recorded during onboard as
    // the machine account's login (unattended) or the user's own GitHub login
    // (solo projects).
    "bot_identity": "auto"
  }
}
